# Serve the integrated site from one canonical hostname.
upstream jadren_web_suit {
    server 127.0.0.1:3000;
    keepalive 32;
}

# Only WebSocket upgrades close the upstream connection; ordinary requests keep
# using the keepalive pool above.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name jadren.me;

    # If Cloudflare proxies the site, uncomment and list its ranges
    # (https://www.cloudflare.com/ips/) so $remote_addr, and therefore
    # X-Real-IP, is the visitor. The app rate-limits by X-Real-IP only.
    # set_real_ip_from 173.245.48.0/20;
    # ...
    # real_ip_header CF-Connecting-IP;

    # The app sends CSP and the other security headers; HSTS belongs to the
    # TLS terminator. Browsers ignore it on plain HTTP, so it is safe to send
    # here when TLS ends in front of nginx (for example at Cloudflare). Add
    # includeSubDomains once every subdomain serves HTTPS.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://jadren_web_suit;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Must be the scheme the browser used: the refresh cookie is only
        # marked Secure when this is https.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # /rpc/ws carries application RPC; 25-second server pings keep it alive.
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name blog.jadren.me tool.jadren.me;
    return 308 $scheme://jadren.me$request_uri;
}
