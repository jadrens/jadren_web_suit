# jadren.cn on shal1, installed as /etc/nginx/conf.d/jadren-web.conf.
#
# Port 443 belongs to the stream block in nginx.conf, which routes TLS by SNI; names it does
# not list (jadren.cn included) fall through to 127.0.0.1:8443 with the PROXY protocol, so the
# HTTPS servers below listen there. cert-pull.timer keeps the *.jadren.cn certificate current.

# Only WebSocket upgrades set Connection; ordinary requests use upstream keepalive.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 80;
    listen [::]:80;
    server_name jadren.cn www.jadren.cn blog.jadren.cn tool.jadren.cn;
    return 301 https://jadren.cn$request_uri;
}

server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    server_name www.jadren.cn blog.jadren.cn tool.jadren.cn;

    ssl_certificate /etc/ssl/private/jadren.cn/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/jadren.cn/key.pem;

    return 308 https://jadren.cn$request_uri;
}

server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    http2 on;
    server_name jadren.cn;

    ssl_certificate /etc/ssl/private/jadren.cn/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/jadren.cn/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The stream block passes the client address in the PROXY protocol header.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    client_max_body_size 20m;

    # If Cloudflare proxies the site, uncomment and list its ranges
    # (https://www.cloudflare.com/ips/) so $remote_addr, and therefore
    # X-Real-IP, is the visitor. The app rate-limits by X-Real-IP only.
    # set_real_ip_from 173.245.48.0/20;
    # ...
    # real_ip_header CF-Connecting-IP;

    # The app sends CSP and the other security headers; HSTS belongs to the
    # TLS terminator. Browsers ignore it on plain HTTP, so it is safe to send
    # here when TLS ends in front of nginx (for example at Cloudflare). Add
    # includeSubDomains once every subdomain serves HTTPS.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Preserve the browser scheme for Secure refresh cookies and WS origin checks.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # /rpc/ws carries application RPC; 25-second server pings keep it alive.
        proxy_read_timeout 60s;
    }
}
